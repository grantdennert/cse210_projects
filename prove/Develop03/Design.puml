@startuml
class Program{
Main() : void
RunMenu() : void
}

class Scripture{
-_scripture : List<Word>
-_reference : Reference

+Scripture(reference : Reference, scripture : string)
+HideWords(amountToHide : int) : void
+IsCompletelyHidden() : bool
+GetScripture() : string
}

class Reference{
-_book : string
-_chapter : int
-_firstVerse : int
-_lastVerse : int

+Reference(book : string, chapter : int, firstVerse : int)
+Reference(book : string, chapter : int, firstVerse : int, lastVerse : int)
+GetReference() : string
}

class Word{
-_word : string
-_isHidden : bool

+Word(text : string)
+Hide(): void
+Show() : void
+IsHidden() : bool
+GetWord() : string
}
Program --> Scripture
Scripture --> Reference
Scripture --> Word
@enduml